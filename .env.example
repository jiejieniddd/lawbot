# Copy to .env — never commit real secrets
APP_ENV=dev

# JWT (JWT_SECRET preferred; SECRET_KEY also accepted)
JWT_SECRET=change-me-in-production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Fernet field encryption for llm_providers.api_key_encrypted
# Production: set a dedicated stable Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# If empty, derived from JWT_SECRET (do not rotate JWT casually or stored keys become unreadable)
ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg://lawbot:lawbot@localhost:5432/lawbot
REDIS_URL=redis://localhost:6379/0

# Local uploads (disk; swap to OSS later). Compose: /workspace/data/uploads volume
UPLOAD_DIR=data/uploads/avatars
AVATAR_MAX_BYTES=2097152
# CareerBot resume / JD (JWT-gated file APIs; not public /uploads static)
RESUME_UPLOAD_DIR=data/uploads/resumes
RESUME_MAX_BYTES=8388608
JD_UPLOAD_DIR=data/uploads/jds
JD_MAX_BYTES=8388608
# Domain D self_test index (isolated from main search_kb)
RAG_SELF_TEST_DIR=data/rag_memory_self_test
# Mock oral-interview bank (isolated; never chat search_kb)
RAG_MOCK_INTERVIEW_DIR=data/rag_memory_mock_interview
# role_skill_map.json is built by scripts/build_role_skill_map.py → data/market/ (not an env var)

# Seed admin (password hashed at seed time; values here are for local/dev only)
SEED_ADMIN_EMAIL=root
SEED_ADMIN_PASSWORD=Aa@123456

# LLM env fallback — prefer Admin「模型供应商」; leave empty for mock when no DB provider
LITELLM_MODEL=
LITELLM_API_KEY=
LLM_MODEL=
LLM_API_KEY=
# Request/connect/first-byte timeout for LiteLLM (not whole-stream wall clock)
LLM_TIMEOUT_SECONDS=60
# Max silence between streamed chunks before truncate + incomplete footer
LLM_STREAM_IDLE_SECONDS=120
# Hard cap for an entire streamed completion
LLM_STREAM_MAX_SECONDS=480
# Answer length (stream only; not classify JSON)
# Explicit LLM_ANSWER_MAX_TOKENS wins over profile. Higher = fuller answers, more latency/cost.
# LLM_ANSWER_MAX_TOKENS=1600
# LLM_ANSWER_PROFILE=normal   # normal=1600 | compact=800

# CORS: local Vite + compose nginx ports
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081

# Host ports (docker compose)
API_PORT=8000
WEB_PORT=8080
ADMIN_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379

# RAG / knowledge import (CareerBot)
# RETRIEVER_MODE: memory (recommended) | hybrid (Qdrant±OS) | fake (dev stub, fake-* cites)
# RAG_* paths: relative → repo root; absolute used as-is
RETRIEVER_MODE=memory
RETRIEVER_TOP_K=5
RRF_K=60
INDEX_BACKEND=memory
RAG_MEMORY_DIR=data/rag_memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lawbot_articles_v1
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=lawbot_articles_v1
# Admin/worker import cap; 0 = no truncation. Career smoke: 200–2000
IMPORT_MAX_ROWS=2000
# Default HF/local path for Admin jobs when config.dataset omitted (Domain A)
HF_DATASET_ID=data/hf/Chinese_interview_large
HF_DATASETS_OFFLINE=1
# Datasets (see README CareerBot 知识导入):
#   A interview_zh → data/hf/Chinese_interview_large → domain interview_qa
#   B dev_docs_en  → data/hf/dev-knowledge-base/data → tech_docs
#   C hive_corpus  → data/hf/the-hive-corpus → gotchas
#   D cmmlu_cs     → data/hf/cmmlu → self_test (RAG_SELF_TEST_DIR only)
#   E ai_job_zh    → data/hf/AI_Job_DataSet_1000_list → job_skills
#   mock_interview_zh → Chinese_interview_large → mock_interview (RAG_MOCK_INTERVIEW_DIR only)
# CLI: scripts/import_career_memory.py --source <id> --max-rows N --embedding-mode fake
# Embeddings (vector — not tokenizer / not chat LLM).
# Prefer Admin「系统设置 → Embedding / 向量检索」; env is fallback default only.
# fake = local hash vectors; litellm = real API; auto = litellm when model+key present
EMBEDDING_MODE=fake
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_DIM=384


# Worker (started by default with docker compose up)
WORKER_POLL_SECONDS=5

# Mail / password reset defaults. Admin「系统设置」saves over these; empty ENCRYPTION_KEY
# derives SMTP password encryption from JWT_SECRET (do not rotate JWT or stored passwords break).
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CareerBot
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60

# Agent step traces (local JSONL). Langfuse optional — empty keys keep it off.
AGENT_TRACE_DIR=data/agent_traces
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
